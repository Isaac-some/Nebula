{
  "name": "nebula-knowledge",
  "version": "0.3.2",
  "private": true,
  "description": "Local-first linked knowledge library and learning graph",
  "license": "MIT",
  "keywords": [
    "knowledge-base",
    "wikilinks",
    "learning",
    "knowledge-graph"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "playwright test",
    "setup:model": "node scripts/setup-model.mjs",
    "preview": "next start --hostname 127.0.0.1 --port 3210",
    "import:research": "tsx scripts/import-research.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.6.0",
    "marked": "^18.1.2",
    "next": "^16.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
